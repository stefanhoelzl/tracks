# Everything the tool produces: the SQLite database and any raw payloads kept
# by sources that cannot cheaply be re-read.
# NOTE: `git clean -xdf` will delete this directory, including the only copy
# of your manual tags.
data/

node_modules/
dist/
*.log
.DS_Store

# Vite build output; `tracks serve` mounts it, `pnpm build` makes it.
packages/web/dist/

# The design mockups the UI was built against. Scratch work, kept on disk and out
# of the history: the artboards and the published canvas bundle are megabytes of
# generated HTML, and nothing in the build reads any of it.
mock/
