# Everything the tool produces: the SQLite database and any raw payloads kept
# by sources that cannot cheaply be re-read.
# NOTE: `git clean -xdf` will delete this directory, including the only copy
# of your manual tags.
data/

# How to reach the deployed database, for a machine without secrets-env. The
# `.secrets.yaml` beside this file is tracked on purpose: it names vault items
# rather than holding their values, so it is worth carrying. `.env` holds the
# real thing, and is not.
.env

node_modules/
dist/
*.log
.DS_Store

# Vite build output; `tracks serve` mounts it, `pnpm build` makes it.
packages/web/dist/
