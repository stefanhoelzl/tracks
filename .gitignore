# Everything the tool produces: the SQLite database and any raw payloads kept
# by sources that cannot cheaply be re-read.
# NOTE: `git clean -xdf` will delete this directory, including the only copy
# of your manual tags.
data/

# How to reach the deployed database. `.proton.yaml` holds no secrets — it names
# items in a password manager — but it names them, and this repository is public.
# `.env` holds the real thing, for a machine without proton-env.
.proton.yaml
.env

node_modules/
dist/
*.log
.DS_Store

# Vite build output; `tracks serve` mounts it, `pnpm build` makes it.
packages/web/dist/
