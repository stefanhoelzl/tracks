{
  "name": "tracks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tracks/web dev",
    "test": "vitest run",
    "check": "biome check . && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web",
    "fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "user:add": "node --experimental-strip-types packages/server/src/add-user.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^24.10.4",
    "drizzle-kit": "^0.31.6",
    "msw": "^2.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
