+  /**
+   * Takes the node/link graph apart once a search is done with it.
+   *
+   * On the JVM dropping the map is enough. Under reference counting (J2ObjC) nodes and links point
+   * at each other, so the graph is never freed and every route leaks it. The walk collects first and
+   * clears afterwards, because a link sits in the link chains of both its nodes.
+   */
+  public void dispose() {
+    java.util.Set<OsmNode> nodes = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<OsmNode, Boolean>());
+    java.util.Set<OsmLink> links = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<OsmLink, Boolean>());
+    List<OsmNode> stack = new ArrayList<>(hmap.values());
+    while (!stack.isEmpty()) {
+      OsmNode n = stack.remove(stack.size() - 1);
+      if (!nodes.add(n)) {
+        continue;
+      }
+      for (OsmLink l = n.firstlink; l != null; l = l.getNext(n)) {
+        links.add(l);
+        OsmNode t = l.getTarget(n);
+        if (t != null && !nodes.contains(t)) {
+          stack.add(t);
+        }
+      }
+    }
+    for (OsmLink l : links) {
+      l.dispose();
+    }
+    for (OsmNode n : nodes) {
+      n.firstlink = null;
+    }
+    hmap.clear();
+    nodes2check = null;
+    destination = null;
+    endNode1 = null;
+    endNode2 = null;
+  }
